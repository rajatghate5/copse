# Server configuration. Copy to .env for local hosted-mode runs.

# Port the server listens on. Render injects its own PORT.
PORT=4040

# Where the built web client lives, served by the same process.
COPSE_STATIC=./packages/web/dist

# Storage backend. Unset => local SQLite file (hotspot / offline mode).
# Set both to use Turso (hosted mode); the server never reads message content
# either way, so Turso only ever holds ciphertext.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Local SQLite path, used only when TURSO_DATABASE_URL is unset.
COPSE_DB=./copse.db

# The first account can only be created with this invite code. After that,
# members generate invites for each other. No code => registration is closed.
COPSE_INVITE=change-me
